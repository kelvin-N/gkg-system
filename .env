# Firebase Demo Configuration for GKG Health Care System
# Set VITE_USE_DEMO=false to use real Firebase (requires valid credentials)

VITE_USE_DEMO=true

# Admin Email Configuration
VITE_ADMIN_EMAIL=admin@gkghealth.com

# Demo Firebase Configuration (not real - for testing only)
VITE_FIREBASE_API_KEY=demo-api-key-for-testing
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:demo123456789